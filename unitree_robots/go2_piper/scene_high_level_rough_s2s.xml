<mujoco model="go2 piper high-level rough s2s">
  <!--
    Dedicated scene for the rough high-level policy.  It keeps the fake_ee
    marker model used by the validated world-pose S2S data path.

    Course geometry (along world +X):
      flat launch area: x < 0.95 m
      five stairs:      0.30 m tread, 0.06 m rise
      upper platform:   z = 0.30 m, x = 2.45 .. 3.75 m

    The step dimensions are inside the rough LLC training ranges
    (0.30 m tread and 0.05 .. 0.13 m rise).  They also match the Key-G target
    profile in the rough deployment control mode.
  -->
  <include file="go2_piper_fake_ee.xml" />

  <statistic center="1.85 0 0.30" extent="2.8" />

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.30 0.30 0.30"
               specular="0.04 0.04 0.04" />
    <rgba haze="0.14 0.20 0.27 1" />
    <global azimuth="-125" elevation="-24" />
  </visual>

  <!-- Set to 0 after recording to restore fake_ee and HLC debug frames. -->
  <custom>
    <numeric name="recording_hide_debug_visuals" data="1" />
  </custom>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.34 0.50 0.68"
             rgb2="0.02 0.03 0.05" width="512" height="3072" />
    <texture type="2d" name="hl_rough_ground_tex" builtin="checker" mark="edge"
             rgb1="0.24 0.28 0.31" rgb2="0.15 0.18 0.21"
             markrgb="0.72 0.72 0.72" width="300" height="300" />
    <material name="hl_rough_ground" texture="hl_rough_ground_tex"
              texuniform="true" texrepeat="8 8" reflectance="0.08" />
    <material name="hl_rough_step_a" rgba="0.63 0.43 0.22 1" />
    <material name="hl_rough_step_b" rgba="0.74 0.52 0.27 1" />
    <material name="hl_rough_platform" rgba="0.28 0.48 0.58 1" />
    <material name="hl_rough_lane_marker" rgba="0.92 0.78 0.18 0.85" />
  </asset>

  <worldbody>
    <light pos="1.8 -1.2 3.2" dir="-0.15 0.08 -1"
           directional="true" diffuse="0.70 0.70 0.70" />

    <geom name="hl_rough_floor" type="plane" size="0 0 0.05"
          material="hl_rough_ground"
          friction="1.0 0.005 0.0001" condim="3" />

    <!-- Each box extends down to the floor, avoiding thin or floating steps. -->
    <geom name="hl_rough_step_01" type="box"
          pos="1.10 0 0.03" size="0.15 1.00 0.03"
          material="hl_rough_step_a"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="hl_rough_step_02" type="box"
          pos="1.40 0 0.06" size="0.15 1.00 0.06"
          material="hl_rough_step_b"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="hl_rough_step_03" type="box"
          pos="1.70 0 0.09" size="0.15 1.00 0.09"
          material="hl_rough_step_a"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="hl_rough_step_04" type="box"
          pos="2.00 0 0.12" size="0.15 1.00 0.12"
          material="hl_rough_step_b"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="hl_rough_step_05" type="box"
          pos="2.30 0 0.15" size="0.15 1.00 0.15"
          material="hl_rough_step_a"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="hl_rough_upper_platform" type="box"
          pos="3.10 0 0.15" size="0.65 1.00 0.15"
          material="hl_rough_platform"
          friction="1.0 0.005 0.0001" condim="3" />

    <!-- Non-colliding visual lane boundaries make yaw/lateral drift obvious. -->
    <geom name="hl_rough_lane_left" type="box"
          pos="2.35 1.04 0.012" size="1.55 0.018 0.012"
          material="hl_rough_lane_marker" contype="0" conaffinity="0" />
    <geom name="hl_rough_lane_right" type="box"
          pos="2.35 -1.04 0.012" size="1.55 0.018 0.012"
          material="hl_rough_lane_marker" contype="0" conaffinity="0" />
  </worldbody>
</mujoco>
