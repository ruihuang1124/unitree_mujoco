<mujoco model="go2_piper training rough approximation">
  <include file="go2_piper_new.xml" />

  <!--
    Deterministic sim-to-sim course approximating the Isaac Lab rough task:
      - stair tread: 0.30 m
      - stair rise:  0.08 m (training range: 0.05-0.13 m)
      - ramp grade:  0.15     (training range: 0.00-0.20)
      - rough noise: 0.08 m   (training range: 0.01-0.08 m)
      - obstacles:   0.05-0.10 m

    The robot starts on the plane at x=0 and the course runs along +x.
    Existing scenes and the shared height-field image are intentionally left
    untouched so checkpoint comparisons use exactly the same terrain.
  -->

  <statistic center="0 0 0.15" extent="1.2" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"
               specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-22" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7"
             rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="training_rough_ground_tex"
             builtin="checker" mark="edge"
             rgb1="0.20 0.24 0.28" rgb2="0.12 0.15 0.18"
             markrgb="0.75 0.75 0.75" width="300" height="300" />
    <material name="training_rough_ground"
              texture="training_rough_ground_tex"
              texuniform="true" texrepeat="8 8" reflectance="0.08" />
    <material name="training_rough_stairs"
              rgba="0.56 0.42 0.25 1" />
    <material name="training_rough_stairs_10cm"
              rgba="0.72 0.45 0.18 1" />
    <material name="training_rough_stairs_12cm"
              rgba="0.72 0.30 0.14 1" />
    <material name="training_rough_ramp"
              rgba="0.25 0.43 0.58 1" />
    <material name="training_rough_noise"
              rgba="0.30 0.38 0.31 1" />
    <material name="training_rough_obstacle"
              rgba="0.55 0.28 0.24 1" />

    <!--
      The image was generated by terrain_tool/terrain_generator.py.  Only its
      physical scale is changed here: 4.0 x 2.4 m with at most 0.08 m relief.
      The include's compiler meshdir is assets/, hence the ../ path.
    -->
    <hfield name="training_rough_hfield"
            size="2.0 1.2 0.08 0.02"
            file="../height_field.png" />
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true" />

    <!-- Flat launch and recovery surface. -->
    <geom name="training_rough_floor"
          type="plane" size="0 0 0.05"
          material="training_rough_ground"
          friction="1.0 0.005 0.0001" condim="3" />

    <!--
      Section 1, center lane: five 0.30 m treads rise by 0.08 m each to a
      0.40 m platform.  The platform ends in a vertical drop to test direct
      descent from a ledge; this lane intentionally has no descending stairs.
    -->
    <geom name="rough_stair_up_01" type="box"
          pos="2.15 0 0.04" size="0.15 1.0 0.04"
          material="training_rough_stairs"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_stair_up_02" type="box"
          pos="2.45 0 0.08" size="0.15 1.0 0.08"
          material="training_rough_stairs"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_stair_up_03" type="box"
          pos="2.75 0 0.12" size="0.15 1.0 0.12"
          material="training_rough_stairs"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_stair_up_04" type="box"
          pos="3.05 0 0.16" size="0.15 1.0 0.16"
          material="training_rough_stairs"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_stair_up_05" type="box"
          pos="3.35 0 0.20" size="0.15 1.0 0.20"
          material="training_rough_stairs"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_stair_platform" type="box"
          pos="4.25 0 0.20" size="0.75 1.0 0.20"
          material="training_rough_stairs"
          friction="1.0 0.005 0.0001" condim="3" />

    <!--
      Section 2, x=6.5..12.0: 0.10 m rise, complete up/platform/down stairs.
      A 1.5 m flat landing separates it from the preceding 0.40 m ledge.
    -->
    <body name="rough_stairs_10cm_section" pos="4.5 0 0">
      <geom name="rough_stair_10cm_up_01" type="box"
            pos="2.15 0 0.05" size="0.15 1.0 0.05"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_up_02" type="box"
            pos="2.45 0 0.10" size="0.15 1.0 0.10"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_up_03" type="box"
            pos="2.75 0 0.15" size="0.15 1.0 0.15"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_up_04" type="box"
            pos="3.05 0 0.20" size="0.15 1.0 0.20"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_up_05" type="box"
            pos="3.35 0 0.25" size="0.15 1.0 0.25"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_up_06" type="box"
            pos="3.65 0 0.30" size="0.15 1.0 0.30"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_up_07" type="box"
            pos="3.95 0 0.35" size="0.15 1.0 0.35"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_up_08" type="box"
            pos="4.25 0 0.40" size="0.15 1.0 0.40"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />

      <geom name="rough_stair_10cm_platform" type="box"
            pos="4.90 0 0.40" size="0.50 1.0 0.40"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />

      <geom name="rough_stair_10cm_down_01" type="box"
            pos="5.55 0 0.35" size="0.15 1.0 0.35"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_down_02" type="box"
            pos="5.85 0 0.30" size="0.15 1.0 0.30"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_down_03" type="box"
            pos="6.15 0 0.25" size="0.15 1.0 0.25"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_down_04" type="box"
            pos="6.45 0 0.20" size="0.15 1.0 0.20"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_down_05" type="box"
            pos="6.75 0 0.15" size="0.15 1.0 0.15"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_down_06" type="box"
            pos="7.05 0 0.10" size="0.15 1.0 0.10"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_10cm_down_07" type="box"
            pos="7.35 0 0.05" size="0.15 1.0 0.05"
            material="training_rough_stairs_10cm"
            friction="1.0 0.005 0.0001" condim="3" />
    </body>

    <!--
      Section 3, x=13.5..19.0: 0.12 m rise, complete up/platform/down stairs.
      It starts after another 1.5 m flat recovery section.
    -->
    <body name="rough_stairs_12cm_section" pos="11.5 0 0">
      <geom name="rough_stair_12cm_up_01" type="box"
            pos="2.15 0 0.06" size="0.15 1.0 0.06"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_up_02" type="box"
            pos="2.45 0 0.12" size="0.15 1.0 0.12"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_up_03" type="box"
            pos="2.75 0 0.18" size="0.15 1.0 0.18"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_up_04" type="box"
            pos="3.05 0 0.24" size="0.15 1.0 0.24"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_up_05" type="box"
            pos="3.35 0 0.30" size="0.15 1.0 0.30"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_up_06" type="box"
            pos="3.65 0 0.36" size="0.15 1.0 0.36"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_up_07" type="box"
            pos="3.95 0 0.42" size="0.15 1.0 0.42"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_up_08" type="box"
            pos="4.25 0 0.48" size="0.15 1.0 0.48"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />

      <geom name="rough_stair_12cm_platform" type="box"
            pos="4.90 0 0.48" size="0.50 1.0 0.48"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />

      <geom name="rough_stair_12cm_down_01" type="box"
            pos="5.55 0 0.42" size="0.15 1.0 0.42"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_down_02" type="box"
            pos="5.85 0 0.36" size="0.15 1.0 0.36"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_down_03" type="box"
            pos="6.15 0 0.30" size="0.15 1.0 0.30"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_down_04" type="box"
            pos="6.45 0 0.24" size="0.15 1.0 0.24"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_down_05" type="box"
            pos="6.75 0 0.18" size="0.15 1.0 0.18"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_down_06" type="box"
            pos="7.05 0 0.12" size="0.15 1.0 0.12"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
      <geom name="rough_stair_12cm_down_07" type="box"
            pos="7.35 0 0.06" size="0.15 1.0 0.06"
            material="training_rough_stairs_12cm"
            friction="1.0 0.005 0.0001" condim="3" />
    </body>

    <!--
      Section 4, x=20.5..26.5: 15% up/down grade with a short plateau.
      The ramp body is 2.4 m long and 0.08 m thick.
    -->
    <geom name="rough_ramp_up" type="box"
          pos="21.70 0 0.1384" size="1.20 1.0 0.04"
          euler="0 -0.14889 0"
          material="training_rough_ramp"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_ramp_platform" type="box"
          pos="23.48 0 0.1780" size="0.60 1.0 0.1780"
          material="training_rough_ramp"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_ramp_down" type="box"
          pos="25.28 0 0.1384" size="1.20 1.0 0.04"
          euler="0 0.14889 0"
          material="training_rough_ramp"
          friction="1.0 0.005 0.0001" condim="3" />

    <!--
      Section 5, x=27.0..31.0: smooth random relief.  The source image stays
      fixed, so old and new policies always see the same profile.
    -->
    <geom name="rough_noise_field"
          type="hfield" hfield="training_rough_hfield"
          pos="29.00 0 0"
          material="training_rough_noise"
          friction="1.0 0.005 0.0001" condim="3" />

    <!--
      Section 6, x=31.2..35.8: deterministic discrete obstacles with the
      same 0.05-0.10 m height range as training.
    -->
    <geom name="rough_obstacle_01" type="box"
          pos="31.65 0 0.025" size="0.45 0.75 0.025"
          material="training_rough_obstacle"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_obstacle_02" type="box"
          pos="32.75 -0.35 0.040" size="0.50 0.55 0.040"
          material="training_rough_obstacle"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_obstacle_03" type="box"
          pos="33.85 0.35 0.050" size="0.60 0.55 0.050"
          material="training_rough_obstacle"
          friction="1.0 0.005 0.0001" condim="3" />
    <geom name="rough_obstacle_04" type="box"
          pos="35.10 0 0.035" size="0.65 1.0 0.035"
          material="training_rough_obstacle"
          friction="1.0 0.005 0.0001" condim="3" />

    <!-- Non-colliding colored section markers at the left edge of the lane. -->
    <site name="rough_marker_stairs" type="box"
          pos="2.0 1.25 0.15" size="0.025 0.025 0.15"
          rgba="0.95 0.63 0.18 1" />
    <site name="rough_marker_stairs_10cm" type="box"
          pos="6.5 1.25 0.15" size="0.025 0.025 0.15"
          rgba="1.00 0.48 0.10 1" />
    <site name="rough_marker_stairs_12cm" type="box"
          pos="13.5 1.25 0.15" size="0.025 0.025 0.15"
          rgba="1.00 0.22 0.08 1" />
    <site name="rough_marker_ramp" type="box"
          pos="20.5 1.25 0.15" size="0.025 0.025 0.15"
          rgba="0.20 0.65 0.95 1" />
    <site name="rough_marker_noise" type="box"
          pos="27.0 1.25 0.15" size="0.025 0.025 0.15"
          rgba="0.22 0.80 0.34 1" />
    <site name="rough_marker_obstacles" type="box"
          pos="31.2 1.25 0.15" size="0.025 0.025 0.15"
          rgba="0.95 0.25 0.18 1" />
  </worldbody>
</mujoco>
