<mujoco model="go2_piper flat scene">
  <include file="go2_piper_fake_ee.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <!-- Pick-place S2S task scene.
         The supports are deliberately far apart in y because the deployed HLC
         currently follows pose commands without obstacle avoidance. -->
    <body name="pick_support" pos="0.65 0.70 0.10">
      <geom name="pick_support_geom" type="box" size="0.07 0.07 0.10"
            rgba="0.32 0.35 0.40 1" friction="1.2 0.005 0.0001" />
    </body>

    <body name="pick_object" pos="0.65 0.65 0.22">
      <freejoint name="pick_object_freejoint" />
      <geom name="pick_object_geom" type="box" size="0.015 0.015 0.015" mass="0.04"
            rgba="0.95 0.12 0.08 1" friction="1.3 0.005 0.0001"
            solref="0.01 1" solimp="0.95 0.99 0.001" />
    </body>

    <body name="place_support" pos="1.45 -0.80 0.375">
      <geom name="place_support_geom" type="box" size="0.11 0.11 0.375"
            rgba="0.25 0.32 0.38 1" friction="1.2 0.005 0.0001" />
    </body>

    <body name="place_target_marker" pos="1.45 -0.80 0.751">
      <geom name="place_target_marker_geom" type="cylinder" size="0.08 0.001"
            rgba="0.10 0.75 0.22 0.65" contype="0" conaffinity="0" />
    </body>
  </worldbody>
</mujoco>
