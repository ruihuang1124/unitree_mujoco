<mujoco model="go2 piper hand trolley pulling task scene">
  <include file="go2_piper_fake_ee.xml" />

  <statistic center="0.7 0 0.35" extent="2.2" />

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.30 0.30 0.30" specular="0.05 0.05 0.05" />
    <rgba haze="0.15 0.22 0.28 1" />
    <global azimuth="-125" elevation="-22" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.52 0.70" rgb2="0.02 0.03 0.05"
             width="512" height="3072" />
    <texture type="2d" name="trolley_ground_tex" builtin="checker" mark="edge"
             rgb1="0.30 0.34 0.38" rgb2="0.18 0.21 0.24" markrgb="0.75 0.75 0.75"
             width="300" height="300" />
    <material name="trolley_ground" texture="trolley_ground_tex" texuniform="true" texrepeat="8 8"
              reflectance="0.12" />
    <material name="cart_deck" rgba="0.16 0.38 0.62 1" />
    <material name="cart_metal" rgba="0.72 0.75 0.78 1" />
    <material name="cart_grip" rgba="0.10 0.11 0.12 1" />
    <material name="cart_wheel" rgba="0.08 0.09 0.10 1" />
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
    <light pos="1.5 -2.5 2.2" dir="0.2 0.4 -1" directional="true" diffuse="0.35 0.35 0.35" />
    <geom name="floor" type="plane" size="0 0 0.05" material="trolley_ground"
          friction="1.0 0.01 0.001" />

    <!-- A compact moving dolly with four low-friction swivel/omni casters.
         Three planar joints emulate free rolling without allowing the cart to
         tip over during this pose-only, no-force-control demonstration. -->
    <body name="hand_trolley" pos="1.55 0 0.15">
      <joint name="trolley_slide_x" type="slide" axis="1 0 0" range="-1.95 0.15" limited="true"
             damping="0.04" frictionloss="0.008" armature="0.002" />
      <joint name="trolley_slide_y" type="slide" axis="0 1 0" range="-0.30 0.30" limited="true"
             damping="0.12" frictionloss="0.015" armature="0.002" />
      <joint name="trolley_yaw" type="hinge" axis="0 0 1" range="-0.35 0.35" limited="true"
             damping="0.08" frictionloss="0.01" armature="0.001" />

      <geom name="trolley_deck" type="box" pos="0 0 0" size="0.45 0.32 0.055"
            mass="0.32" material="cart_deck" friction="0.3 0.005 0.0005" />
      <geom name="trolley_bumper" type="box" pos="0.39 0 0.075" size="0.035 0.29 0.035"
            mass="0.04" material="cart_metal" />

      <!-- Visual caster brackets and spherical omni wheels.  Contact is
           disabled because the planar joints provide the rolling mechanics. -->
      <geom type="capsule" fromto="-0.34 -0.24 -0.035 -0.34 -0.24 -0.085" size="0.018"
            material="cart_metal" contype="0" conaffinity="0" />
      <geom type="sphere" pos="-0.34 -0.24 -0.11" size="0.042" material="cart_wheel"
            contype="0" conaffinity="0" />
      <geom type="capsule" fromto="-0.34 0.24 -0.035 -0.34 0.24 -0.085" size="0.018"
            material="cart_metal" contype="0" conaffinity="0" />
      <geom type="sphere" pos="-0.34 0.24 -0.11" size="0.042" material="cart_wheel"
            contype="0" conaffinity="0" />
      <geom type="capsule" fromto="0.34 -0.24 -0.035 0.34 -0.24 -0.085" size="0.018"
            material="cart_metal" contype="0" conaffinity="0" />
      <geom type="sphere" pos="0.34 -0.24 -0.11" size="0.042" material="cart_wheel"
            contype="0" conaffinity="0" />
      <geom type="capsule" fromto="0.34 0.24 -0.035 0.34 0.24 -0.085" size="0.018"
            material="cart_metal" contype="0" conaffinity="0" />
      <geom type="sphere" pos="0.34 0.24 -0.11" size="0.042" material="cart_wheel"
            contype="0" conaffinity="0" />

      <!-- U-frame handle on the robot-facing (-x) end. -->
      <geom type="capsule" fromto="-0.40 -0.24 0.03 -0.48 -0.24 0.48" size="0.016"
            mass="0.035" material="cart_metal" />
      <geom type="capsule" fromto="-0.40 0.24 0.03 -0.48 0.24 0.48" size="0.016"
            mass="0.035" material="cart_metal" />
      <!-- The conventional horizontal crossbar is the tracked/grasped handle.
           Its 10 mm radius matches the drawer handle and leaves no artificial
           vertical centre grip in the trolley model. -->
      <body name="trolley_handle" pos="-0.48 0 0.48">
        <geom name="trolley_handle_grip" type="capsule"
              fromto="0 -0.22 0 0 0.22 0" size="0.010"
              mass="0.04" material="cart_grip" friction="4.0 0.04 0.004"
              solref="0.01 1" solimp="0.97 0.995 0.001" />
      </body>
    </body>

    <!-- Desired final cart centre and corresponding handle centre. -->
    <body name="trolley_goal_marker" pos="-0.25 0 0.008">
      <geom type="box" size="0.47 0.34 0.006" rgba="0.12 0.82 0.24 0.32"
            contype="0" conaffinity="0" />
    </body>
    <body name="trolley_pull_target" pos="-0.73 0 0.63">
      <geom type="sphere" size="0.025" rgba="0.95 0.75 0.08 0.55"
            contype="0" conaffinity="0" />
    </body>
  </worldbody>
</mujoco>
