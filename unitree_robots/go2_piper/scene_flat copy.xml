<mujoco model="go2_piper flat scene">
  <include file="go2_piper_fake_ee.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <!-- 15 cm-high compact pick pedestal at the robot's left-front. -->
    <geom name="pick_support" type="box" pos="0.65 0.28 0.075" size="0.07 0.07 0.10"
          rgba="0.32 0.35 0.40 1" friction="1.2 0.01 0.001" />

    <!-- A 4 cm-diameter, 100 g ball on the pick pedestal (top surface z=0.15 m). -->
    <body name="pick_object" pos="0.65 0.28 0.172">
      <freejoint name="pick_object_freejoint" />
      <geom name="pick_object_geom" type="sphere" size="0.02" mass="0.1"
            rgba="0.95 0.12 0.08 1" friction="1.3 0.02 0.002" condim="4"
            solref="0.004 1" solimp="0.95 0.99 0.001" />
    </body>

    <!-- Place pedestal farther at the robot's right-front; top surface z=0.22 m. -->
    <geom name="place_support" type="box" pos="1.45 -0.35 0.11" size="0.11 0.11 0.11"
          rgba="0.25 0.32 0.38 1" friction="1.2 0.01 0.001" />
    <geom name="place_target_marker" type="cylinder" pos="1.45 -0.35 0.221"
          size="0.08 0.001" rgba="0.10 0.75 0.22 0.75" contype="0" conaffinity="0" />
  </worldbody>
</mujoco>
