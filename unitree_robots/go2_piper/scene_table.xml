<mujoco model="go2 piper table wiping task scene">
  <include file="go2_piper_fake_ee.xml" />

  <statistic center="1.25 0 0.35" extent="2.6" />

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.30 0.30 0.30" specular="0.05 0.05 0.05" />
    <rgba haze="0.15 0.22 0.28 1" />
    <global azimuth="-125" elevation="-22" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.52 0.70" rgb2="0.02 0.03 0.05"
             width="512" height="3072" />
    <texture type="2d" name="table_ground_tex" builtin="checker" mark="edge"
             rgb1="0.30 0.34 0.38" rgb2="0.18 0.21 0.24" markrgb="0.75 0.75 0.75"
             width="300" height="300" />
    <material name="table_ground" texture="table_ground_tex" texuniform="true" texrepeat="8 8"
              reflectance="0.12" />
    <material name="table_top" rgba="0.52 0.34 0.18 1" />
    <material name="table_leg" rgba="0.22 0.24 0.26 1" />
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
    <light pos="1.5 -2.5 2.2" dir="0.2 0.4 -1" directional="true" diffuse="0.35 0.35 0.35" />
    <geom name="floor" type="plane" size="0 0 0.05" material="table_ground"
          friction="1.0 0.01 0.001" />

    <!-- The eraser starts directly on the near-right corner of the table,
         outside the marked wipe area.  No separate pickup stand is needed. -->
    <body name="wipe_table" pos="2.15 0 0">
      <!-- Table top lowered by 10 cm: upper surface z=0.46. -->
      <geom name="wipe_table_top" type="box" pos="0 0 0.42" size="0.38 0.46 0.04"
            material="table_top" friction="1.0 0.01 0.001" />
      <geom type="box" pos="-0.30 -0.38 0.19" size="0.035 0.035 0.19" material="table_leg" />
      <geom type="box" pos="-0.30 0.38 0.19" size="0.035 0.035 0.19" material="table_leg" />
      <geom type="box" pos="0.30 -0.38 0.19" size="0.035 0.035 0.19" material="table_leg" />
      <geom type="box" pos="0.30 0.38 0.19" size="0.035 0.035 0.19" material="table_leg" />
    </body>
    <body name="table_wipe_frame" pos="2.11 0 0.476">
      <geom type="box" size="0.20 0.32 0.002" rgba="0.10 0.65 0.95 0.22"
            contype="0" conaffinity="0" />
    </body>
    <!-- Table top is z=0.46; the 36 mm-thick eraser therefore starts at
         z=0.478.  Its y=-0.40 placement is just outside the wipe range
         [-0.30, +0.30] while remaining fully supported by the tabletop. -->
    <body name="table_eraser" pos="1.86 -0.40 0.478">
      <freejoint name="table_eraser_freejoint" />
      <!-- 50 x 50 x 36 mm, 5 g foam-like eraser: thick for a positive
           two-finger pinch and very light during lift/transport. -->
      <geom name="table_eraser_geom" type="box" size="0.025 0.025 0.018" mass="0.005"
            rgba="0.10 0.55 0.95 1" friction="2.5 0.02 0.002"
            solref="0.01 1" solimp="0.95 0.99 0.001" />
    </body>
  </worldbody>
</mujoco>
