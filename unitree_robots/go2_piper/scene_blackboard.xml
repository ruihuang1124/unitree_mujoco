<mujoco model="go2 piper blackboard wiping task scene">
  <include file="go2_piper_fake_ee.xml" />

  <statistic center="1.25 0 0.45" extent="2.6" />

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.30 0.30 0.30" specular="0.05 0.05 0.05" />
    <rgba haze="0.15 0.22 0.28 1" />
    <global azimuth="-125" elevation="-22" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.52 0.70" rgb2="0.02 0.03 0.05"
             width="512" height="3072" />
    <texture type="2d" name="board_ground_tex" builtin="checker" mark="edge"
             rgb1="0.30 0.34 0.38" rgb2="0.18 0.21 0.24" markrgb="0.75 0.75 0.75"
             width="300" height="300" />
    <material name="board_ground" texture="board_ground_tex" texuniform="true" texrepeat="8 8"
              reflectance="0.12" />
    <material name="board_surface" rgba="0.055 0.15 0.10 1" />
    <material name="board_frame" rgba="0.65 0.67 0.70 1" />
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
    <light pos="1.5 -2.5 2.2" dir="0.2 0.4 -1" directional="true" diffuse="0.35 0.35 0.35" />
    <geom name="floor" type="plane" size="0 0 0.05" material="board_ground"
          friction="1.0 0.01 0.001" />

    <!-- A shallow tray projects about 12 cm from the lower blackboard frame.
         The eraser starts on this tray, so no separate pickup stand is needed. -->
    <body name="blackboard" pos="2.15 0 0.63">
      <geom name="blackboard_surface" type="box" size="0.040 0.76 0.34"
            material="board_surface" friction="1.0 0.01 0.001" />
      <geom type="box" pos="0 -0.81 0" size="0.055 0.05 0.40" material="board_frame" />
      <geom type="box" pos="0 0.81 0" size="0.055 0.05 0.40" material="board_frame" />
      <geom type="box" pos="0 0 -0.39" size="0.055 0.86 0.05" material="board_frame" />
      <geom type="box" pos="0 0 0.39" size="0.055 0.86 0.05" material="board_frame" />
      <geom name="blackboard_eraser_tray" type="box" pos="-0.10 0 -0.355"
            size="0.06 0.70 0.025" material="board_frame"
            friction="1.1 0.01 0.001" />
    </body>
    <!-- Four millimetres of no-force clearance from the front surface. -->
    <body name="blackboard_wipe_frame" pos="2.094 0 0.63">
      <geom type="box" size="0.002 0.58 0.25" rgba="0.95 0.65 0.10 0.20"
            contype="0" conaffinity="0" />
    </body>
    <!-- Tray top is z=0.30.  The eraser is placed in its real-task side-grasp
         pose: thin x dimension faces the board, 50 mm y dimension lies across
         the gripper closing direction, and its center is next to the wipe start. -->
    <body name="board_eraser" pos="2.04 -0.52 0.322">
      <freejoint name="board_eraser_freejoint" />
      <!-- 36 x 50 x 44 mm, 5 g: easy side pinch and a broad vertical wipe face. -->
      <geom name="board_eraser_geom" type="box" size="0.018 0.025 0.022" mass="0.005"
            rgba="0.95 0.48 0.08 1" friction="2.5 0.02 0.002"
            solref="0.01 1" solimp="0.95 0.99 0.001" />
    </body>
  </worldbody>
</mujoco>
